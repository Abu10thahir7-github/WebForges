# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Compiled CSS output & source maps — SCSS is the source of truth,
# the compiled .css/.css.map next to it shouldn't be committed
*.css.map
# NOTE: if you have hand-written (not SCSS-compiled) CSS files you DO want
# tracked, this line is too broad — scope it per-folder instead, e.g.
# src/styles/*.css.map, src/pages/**/*.css.map

# Windows shortcut files (the assets.lnk issue)
*.lnk

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env files — never commit secrets/API keys
.env
.env.local
.env.*.local

# Vercel
.vercel

# Build/test artifacts
coverage
*.tsbuildinfo